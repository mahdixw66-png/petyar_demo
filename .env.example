# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی — فقط نام و توضیح. هیچ مقدار واقعی/رمز در این فایل نیست.
# کپی: cp .env.example .env   و سپس مقادیر را برای محیط خود تنظیم کنید.
# ---------------------------------------------------------------------------

# --- پایگاه داده -----------------------------------------------------------
# رشتهٔ اتصال PostgreSQL. در Docker از نام سرویس (db) استفاده می‌شود.
DATABASE_URL="postgresql://petins:petins_dev_password@localhost:5432/pet_insurance_dev?schema=public"
# پایگاه دادهٔ جداگانه برای اجرای تست‌های یکپارچه (هرگز با دیتای توسعه یکی نباشد)
TEST_DATABASE_URL="postgresql://petins:petins_dev_password@localhost:5432/pet_insurance_test?schema=public"

# --- امنیت / نشست ----------------------------------------------------------
# کلید امضای JWT نشست. حداقل ۳۲ بایت تصادفی.
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-secret-min-32-bytes"
# عمر نشست (ثانیه) — پیش‌فرض ۷ روز
SESSION_TTL_SECONDS="604800"
# کلید امضای لینک‌های کوتاه‌عمر دانلود فایل (می‌تواند همان AUTH_SECRET باشد)
FILE_SIGNING_SECRET="replace-me-with-another-long-random-secret"
# عمر لینک امضاشدهٔ فایل (ثانیه) — پیش‌فرض ۵ دقیقه
FILE_LINK_TTL_SECONDS="300"

# --- برنامه ----------------------------------------------------------------
# محیط اجرا: development | test | production
NODE_ENV="development"
# آدرس عمومی سایت (برای لینک‌ها، manifest و بررسی Origin در CSRF)
APP_URL="http://localhost:3000"
# پورت سرور Next.js
PORT="3000"
# لاگ SQL پرینت‌شود؟ (فقط توسعه)
LOG_QUERIES="false"

# --- ذخیره‌سازی فایل (خصوصی) ------------------------------------------------
# local = ذخیره روی دیسک در مسیر STORAGE_DIR (دسترسی فقط از طریق APIauthorized)
# s3    = سازگار با S3 (فقط درایور، نیازمند credential واقعی در استقرار)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/uploads"
# برای STORAGE_DRIVER=s3 (در MVP استفاده نمی‌شود؛ برای استقرار آینده)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
# حداکثر اندازهٔ فایل (بایت) — پیش‌فرض ۱۰ مگابایت
MAX_UPLOAD_BYTES="10485760"

# --- حساب‌های دمو (فقط توسعه) -----------------------------------------------
# ایجاد/به‌روزرسانی حساب‌های دمو هنگام اجرای seed. در production باید false باشد.
SEED_DEMO_ACCOUNTS="true"
# رمز یکسان برای همهٔ حساب‌های دمو (فقط توسعه؛ در production نادیده گرفته می‌شود)
DEMO_PASSWORD="Demo@12345"

# --- محدودسازی نرخ ----------------------------------------------------------
# در حافظهٔ همان process است؛ در استقرار چندنمونه‌ای باید Redis جایگزین شود.
RATE_LIMIT_LOGIN_PER_MINUTE="5"
RATE_LIMIT_SENSITIVE_PER_MINUTE="20"

# --- برچسب دمو --------------------------------------------------------------
# نمایش بنر «نسخهٔ دمو — داده‌ها و نرخ‌ها نمونه و تأییدنشده‌اند»
NEXT_PUBLIC_DEMO_MODE="true"
