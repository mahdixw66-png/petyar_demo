# برای Vercel / پروداکشن - این مقادیر را در Vercel Environment Variables بگذارید
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="تولید: node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
FILE_SIGNING_SECRET="همان AUTH_SECRET یا یکی دیگر با دستور بالا"
APP_URL="https://YOUR-PROJECT.vercel.app"
NODE_ENV="production"
NEXT_PUBLIC_DEMO_MODE="false"
SEED_DEMO_ACCOUNTS="false"
STORAGE_DRIVER="local"
